FROM qwenllm/qwen3-asr:latest

WORKDIR /workspace

RUN python -m pip install --no-cache-dir \
    "silero-vad>=5.1.2" \
    "websockets>=12.0"

COPY resources/local-service-qwen/service.py /workspace/resources/local-service-qwen/service.py

ENV JUSTSAY_LOCAL_SERVICE_HOST=0.0.0.0
ENV JUSTSAY_LOCAL_SERVICE_PORT=8765
ENV JUSTSAY_LOCAL_SERVICE_MODEL=Qwen/Qwen3-ASR-1.7B
ENV JUSTSAY_LOCAL_SERVICE_RUNTIME_FAMILY=qwen3-asr
ENV JUSTSAY_QWEN_BACKEND=vllm
ENV JUSTSAY_QWEN_GPU_MEMORY_UTILIZATION=0.55
ENV JUSTSAY_QWEN_MAX_MODEL_LEN=8192
ENV JUSTSAY_QWEN_MAX_NEW_TOKENS=32

EXPOSE 8765

CMD ["python", "/workspace/resources/local-service-qwen/service.py"]
